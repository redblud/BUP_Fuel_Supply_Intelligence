APP_ENV=development
LOG_LEVEL=INFO

# fake = serve tests/fixtures/<FIXTURE_SCENARIO>.json (no simulator needed)
# real = talk to the BUP simulator at SIMULATOR_BASE_URL
SIMULATOR_MODE=fake
FIXTURE_SCENARIO=route-disruption

# In Docker Compose (--profile sim): http://simulator:8000
# Backend running on the host with the simulator in Docker: http://127.0.0.1:9000
SIMULATOR_BASE_URL=http://simulator:8000
SIMULATOR_CONNECT_TIMEOUT=2
SIMULATOR_READ_TIMEOUT=5

# Compose overrides this to /data/fuelops.db on the persistent volume.
# Unset locally = <repo>/data/fuelops.db
# DATABASE_URL=sqlite+aiosqlite:////data/fuelops.db

# Shared secret for approve, reject, mode/kill switch and demo controls (sent as X-Operator-Token).
# Empty = those routes stay closed (401). Use a long random value outside local development.
OPERATOR_TOKEN=dev-operator-token
# Simulator run/pause/step buttons. Needs the operator token as well.
DEMO_CONTROLS_ENABLED=true

AUTOMATION_DEFAULT_MODE=ADVISORY
SNAPSHOT_TICK_TOLERANCE=1

# Empty = same origin through the Vite proxy (recommended). Or http://localhost:8000 (CORS is enabled for :5173).
VITE_API_BASE_URL=
